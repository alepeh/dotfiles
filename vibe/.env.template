# Mistral Vibe — credentials
# This is a TEMPLATE. The installer copies it to ~/.vibe/.env (chmod 600) if that
# file does not already exist; edit ~/.vibe/.env, not this template.
#
# Vibe reads its API key from (in precedence order):
#   1. the MISTRAL_API_KEY environment variable
#   2. ~/.vibe/.env  (this file, once copied)
#
# Alternatively, run `vibe --setup` for an interactive wizard that writes this file
# for you. Get a key at https://console.mistral.ai/
#
# Setup:
#   1. cp vibe/.env.template ~/.vibe/.env   (the installer does this automatically)
#   2. Edit ~/.vibe/.env and replace the placeholder below
#   3. chmod 600 ~/.vibe/.env

export MISTRAL_API_KEY="your_mistral_api_key_here"
