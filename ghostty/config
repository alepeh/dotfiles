# Ghostty configuration

# Font — MesloLGS Nerd Font (installed via Brewfile cask font-meslo-lg-nerd-font)
font-family = "MesloLGS Nerd Font"
font-size = 14

# Theme — Catppuccin Mocha (matches Zellij/Helix theme)
theme = "Catppuccin Mocha"

# Window appearance
window-padding-x = 4
window-padding-y = 4
window-decoration = true

# Tabs & splits
# NOTE: Ghostty has no vertical tabs (cmux's headline feature). macOS uses
# native horizontal tabs in the titlebar. Splits fill the vertical-pane gap.
#   New tab:   cmd+t        Next/prev tab:  cmd+shift+]/[
#   Split:     cmd+d (right) / cmd+shift+d (down)   Nav: cmd+alt+arrows
macos-titlebar-style = tabs
window-new-tab-position = end

# Clipboard
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
