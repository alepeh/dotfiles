# Ghostty configuration

# Font — MesloLGS Nerd Font (installed via Brewfile cask font-meslo-lg-nerd-font)
font-family = "MesloLGS Nerd Font"
font-size = 14

# Theme — Catppuccin Mocha (matches Zellij/Helix theme)
theme = "Catppuccin Mocha"

# Window appearance
window-padding-x = 4
window-padding-y = 4
window-decoration = true

# Tabs & splits
# NOTE: Ghostty has no vertical tabs (cmux's headline feature). macOS uses
# native horizontal tabs in the titlebar. Splits fill the vertical-pane gap.
#   New tab:   cmd+t        Next/prev tab:  cmd+shift+]/[
#   Split:     cmd+d (right) / cmd+shift+d (down)   Nav: cmd+alt+arrows
macos-titlebar-style = tabs
window-new-tab-position = end

# Clipboard
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# Attention / notifications
# Goal: know when an agent (Claude Code, cursor-agent, etc.) needs input, and
# WHICH tab/split it is in. These agents ring the terminal bell (OSC) when they
# want attention; bell-features decides what Ghostty does with that bell.
#   attention → bounce the dock icon once while Ghostty is unfocused
#   title     → prepend 🔔 to the alerted TAB's title until re-focused (which tab)
#   border    → outline the alerted SPLIT until re-focused (which split)
#   system    → play the macOS system alert sound
# audio (custom sound file) is left off; system covers the audible cue.
bell-features = attention,title,border,system

# NOTE: notify-on-command-finish* (auto desktop notification when a long command
# ends) is GTK/Linux-only in Ghostty 1.3.x and has no effect on macOS, so it is
# intentionally omitted. On macOS the bell-features above are the mechanism.
# Shell integration (needed for bell delivery) is injected automatically by
# Ghostty for zsh — no sourcing required.
