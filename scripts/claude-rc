#!/usr/bin/env bash
# claude-rc — keep `claude remote-control` (server mode) running per repo via launchd.
#
# Each enabled repo gets a LaunchAgent (RunAtLoad + KeepAlive), so the server
# survives closing the terminal, logging out/in and reboots, and restarts if it
# exits (server mode quits after ~10 min without network).
#
#   claude-rc                 interactive picker (fzf if installed, else numbered menu)
#   claude-rc enable  <repo>… enable repos (name under $CLAUDE_RC_ROOT or a path)
#   claude-rc disable <repo>… disable repos
#   claude-rc status          show every repo with a remote-control agent
#   claude-rc logs <repo>     tail the server log
#
# Options for enable (and the picker):
#   --spawn same-dir|worktree|session   default: worktree
#   --mode  <permission-mode>           default: bypassPermissions
#
# Env: CLAUDE_RC_ROOT (default ~/code), CLAUDE_BIN (default: `command -v claude`).

set -euo pipefail

ROOT="${CLAUDE_RC_ROOT:-$HOME/code}"
CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude || true)}"
AGENTS_DIR="$HOME/Library/LaunchAgents"
LOG_DIR="$HOME/Library/Logs/claude-rc"
PREFIX="biz.pehm.claude-rc"
DOMAIN="gui/$(id -u)"
SPAWN="worktree"
MODE="bypassPermissions"

die() { echo "claude-rc: $*" >&2; exit 1; }

slug() { basename "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-'; }
label_for() { echo "$PREFIX.$(slug "$1")"; }
plist_for() { echo "$AGENTS_DIR/$(label_for "$1").plist"; }

resolve() {
  local r="$1"
  [[ -d "$r" ]] || r="$ROOT/$r"
  [[ -d "$r/.git" || -f "$r/.git" ]] || die "not a git repo: $1"
  (cd "$r" && pwd -P)
}

list_repos() {
  local d
  for d in "$ROOT"/*/; do
    d="${d%/}"
    [[ -e "$d/.git" ]] && echo "$d"
  done
}

# Any LaunchAgent (ours or hand-made) that runs `claude remote-control` in this dir.
foreign_agent_for() {
  local repo="$1" f
  for f in "$AGENTS_DIR"/*.plist; do
    [[ -f "$f" && "$f" != "$(plist_for "$repo")" ]] || continue
    grep -q "<string>remote-control</string>" "$f" 2>/dev/null || continue
    grep -qF "<string>$repo</string>" "$f" 2>/dev/null && { basename "$f" .plist; return; }
  done
}

state_of() {
  local repo="$1" label other
  label="$(label_for "$repo")"
  if [[ -f "$(plist_for "$repo")" ]]; then
    if launchctl print "$DOMAIN/$label" 2>/dev/null | grep -q "state = running"; then
      echo "on"
    else
      echo "on (not running)"
    fi
  elif other="$(foreign_agent_for "$repo")" && [[ -n "$other" ]]; then
    echo "external:$other"
  else
    echo "off"
  fi
}

xml_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' <<<"$1"; }

enable_repo() {
  local repo name label plist other
  repo="$(resolve "$1")"
  name="$(basename "$repo")"
  label="$(label_for "$repo")"
  plist="$(plist_for "$repo")"
  other="$(foreign_agent_for "$repo")"
  if [[ -n "$other" ]]; then
    echo "skip  $name — already served by $other"
    return
  fi
  [[ -x "$CLAUDE_BIN" ]] || die "claude binary not found (set CLAUDE_BIN)"
  mkdir -p "$AGENTS_DIR" "$LOG_DIR"

  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by claude-rc. Remove with: claude-rc disable $name -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>ProgramArguments</key>
    <array>
        <string>$CLAUDE_BIN</string>
        <string>remote-control</string>
        <string>--spawn</string>
        <string>$SPAWN</string>
        <string>--permission-mode</string>
        <string>$MODE</string>
        <string>--remote-control-session-name-prefix</string>
        <string>$(slug "$repo")</string>
    </array>
    <key>WorkingDirectory</key>
    <string>$(xml_escape "$repo")</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>$(xml_escape "$PATH")</string>
        <key>HOME</key>
        <string>$HOME</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>$LOG_DIR/$name.log</string>
    <key>StandardErrorPath</key>
    <string>$LOG_DIR/$name.log</string>
</dict>
</plist>
EOF
  plutil -lint -s "$plist" || die "generated invalid plist: $plist"
  launchctl bootout "$DOMAIN/$label" 2>/dev/null || true
  launchctl bootstrap "$DOMAIN" "$plist"
  echo "on    $name  (spawn=$SPAWN, mode=$MODE, log: $LOG_DIR/$name.log)"
}

disable_repo() {
  local repo name label plist other
  repo="$(resolve "$1")"
  name="$(basename "$repo")"
  label="$(label_for "$repo")"
  plist="$(plist_for "$repo")"
  if [[ ! -f "$plist" ]]; then
    other="$(foreign_agent_for "$repo")"
    if [[ -n "$other" ]]; then
      echo "skip  $name — served by $other, which claude-rc does not manage"
    else
      echo "off   $name (was not enabled)"
    fi
    return
  fi
  launchctl bootout "$DOMAIN/$label" 2>/dev/null || true
  rm -f "$plist"
  echo "off   $name"
}

cmd_status() {
  local repo st found=0
  while IFS= read -r repo; do
    st="$(state_of "$repo")"
    [[ "$st" == off ]] && continue
    found=1
    printf '%-18s %s\n' "$st" "$(basename "$repo")"
  done < <(list_repos)
  [[ $found == 1 ]] || echo "no repos under $ROOT have remote-control enabled"
}

cmd_pick() {
  local repos=() repo st line chosen=() i sel
  while IFS= read -r repo; do repos+=("$repo"); done < <(list_repos)
  [[ ${#repos[@]} -gt 0 ]] || die "no git repos under $ROOT"

  # Selecting a repo toggles it: off → on, on → off. External agents are left alone.
  if command -v fzf >/dev/null; then
    local menu=""
    for repo in "${repos[@]}"; do
      menu+="$(printf '%-18s %s' "[$(state_of "$repo")]" "$(basename "$repo")")"$'\n'
    done
    while IFS= read -r line; do
      [[ -n "$line" ]] && chosen+=("$ROOT/${line##* }")
    done < <(printf '%s' "$menu" | fzf --multi --reverse \
      --header="TAB select, ENTER apply — selected repos are toggled on/off (spawn=$SPAWN, mode=$MODE)" || true)
  else
    for i in "${!repos[@]}"; do
      printf '%3d) %-18s %s\n' $((i + 1)) "[$(state_of "${repos[$i]}")]" "$(basename "${repos[$i]}")"
    done
    read -r -p "Numbers to toggle (space-separated, empty to cancel): " sel
    for i in $sel; do
      [[ "$i" =~ ^[0-9]+$ && $i -ge 1 && $i -le ${#repos[@]} ]] || die "invalid choice: $i"
      chosen+=("${repos[$((i - 1))]}")
    done
  fi

  [[ ${#chosen[@]} -gt 0 ]] || { echo "nothing selected"; return; }
  for repo in "${chosen[@]}"; do
    case "$(state_of "$repo")" in
      off) enable_repo "$repo" ;;
      external:*) echo "skip  $(basename "$repo") — managed by $(state_of "$repo" | cut -d: -f2)" ;;
      *) disable_repo "$repo" ;;
    esac
  done
}

# --- argument parsing --------------------------------------------------------
cmd="${1:-pick}"
[[ $# -gt 0 ]] && shift
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --spawn) SPAWN="${2:?}"; shift 2 ;;
    --mode) MODE="${2:?}"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
case "$SPAWN" in same-dir|worktree|session) ;; *) die "bad --spawn: $SPAWN" ;; esac

case "$cmd" in
  pick) cmd_pick ;;
  enable|on)   [[ ${#args[@]} -gt 0 ]] || die "enable needs repo names"; for r in "${args[@]}"; do enable_repo "$r"; done ;;
  disable|off) [[ ${#args[@]} -gt 0 ]] || die "disable needs repo names"; for r in "${args[@]}"; do disable_repo "$r"; done ;;
  status|ls) cmd_status ;;
  logs) [[ ${#args[@]} -eq 1 ]] || die "logs needs one repo"; tail -n 50 -f "$LOG_DIR/$(basename "$(resolve "${args[0]}")").log" ;;
  -h|--help|help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
  --spawn|--mode) die "put options after the command, e.g. claude-rc pick --spawn same-dir" ;;
  *) die "unknown command: $cmd (try --help)" ;;
esac
